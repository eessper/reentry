# Re-entry environment variables. Copy what you need into your host's
# settings or a local .env file. Never commit real values: anything marked
# SECRET goes in a secret store (GitHub secrets, `npx supabase secrets set`).
# See docs/TECHNICAL_GUIDE.md section 2.

# --- Web app (read at build time; public by design, RLS protects the data) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SB_PUBLISHABLE_KEY=<publishable key from the Supabase dashboard>
# true builds the in-browser demo with no backend
VITE_IS_DEMO=false
VITE_ATTACHMENTS_BUCKET=attachments

# --- Admin scripts (scripts/create-organisation.mjs, scripts/seed-demo.mjs) ---
SUPABASE_URL=https://<project-ref>.supabase.co
# SECRET: bypasses row-level security. Trusted machines and edge functions only.
SUPABASE_SERVICE_ROLE_KEY=
# Local and staging demo data only
DEMO_PASSWORD=demo-password

# --- CI deploy job (GitHub repository secrets) ---
# SECRET
SUPABASE_ACCESS_TOKEN=
# SECRET
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_ID=<project-ref>

# --- Phase 2: WhatsApp Business Cloud API (edge function secrets) ---
# SECRET: system user token with access to the WhatsApp Business Account
WHATSAPP_ACCESS_TOKEN=
# SECRET: Meta app secret, used to check webhook signatures
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
# SECRET: random string you choose when registering the webhook
WHATSAPP_VERIFY_TOKEN=

# --- Phase 2: AI via Amazon Bedrock in a UK/EU region (edge function secrets) ---
AWS_REGION=eu-west-2
# SECRET: IAM user limited to bedrock:InvokeModel* on the chosen model
AWS_ACCESS_KEY_ID=
# SECRET
AWS_SECRET_ACCESS_KEY=
